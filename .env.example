# OpenShell on Blaxel -- local settings.
# Copy to .env and edit. gw/env.sh loads it automatically. .env is gitignored.
# No secret is required here: Blaxel auth comes from `bl login` (or BL_API_KEY),
# and Anthropic keys go into OpenShell providers, never into this file.

# --- Blaxel target ---------------------------------------------------------
# Workspace, environment (prod or dev) and region where sandboxes are created.
# The region must support the `landlock` kernel variant (see docs/KERNEL.md).
BL_WORKSPACE=charlou-dev
BL_ENV=dev
BL_REGION=us-was-1
# Optional: a service-account key instead of the `bl login` session. The driver
# sends it as a bearer token to the Blaxel API and the sandbox tunnel.
# BL_API_KEY=

# --- Sandbox runtime -------------------------------------------------------
# Kernel variant enabled through spec.runtime.extraArgs. Empty = default kernel
# (no Landlock). Fixed at sandbox creation.
KERNEL_VARIANT=landlock
# Packages installed as root at bootstrap (the workload runs as uid 1500 and
# cannot install anything itself).
SANDBOX_PACKAGES=curl,git,ca-certificates

# --- Local gateway ---------------------------------------------------------
# CLI gateway name and loopback port. The same port is used inside each VM for
# the reverse tunnel endpoint.
GATEWAY_NAME=blaxel
GATEWAY_PORT=17680
DRIVER_SOCKET=/tmp/openshell-blaxel/driver.sock
# OpenShell v0.0.116 gateway binary. Defaults to the one on PATH, then Homebrew.
# OPENSHELL_GATEWAY_BIN=/opt/homebrew/opt/openshell/bin/openshell-gateway
