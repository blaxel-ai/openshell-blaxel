# OpenShell (main) on Blaxel -- local settings.
# Copy to .env and edit. gw/env.sh loads it automatically. .env is gitignored.

# --- Blaxel target ---------------------------------------------------------
# Workspace, environment and region for the control sandbox and
# the workload sandboxes. Workloads need the `landlock` kernel variant
# (docs/KERNEL.md); the control sandbox uses the `tun` + `iptables` variants.
BL_WORKSPACE=my-workspace
BL_ENV=prod
BL_REGION=us-was-1

# Service-account key. `make deploy` stores it in a root-only file in the
# control sandbox, read by the driver process only, which uses it to create
# workload sandboxes. The laptop tools use it too (or your `bl login` session).
# Required for `make deploy`.
BL_API_KEY=

# --- Control plane ---------------------------------------------------------
# Control sandbox name, and the driver-owner label / CLI gateway name. Each
# control plane owns only the sandboxes carrying its owner label.
CONTROL_SANDBOX=os-control
GATEWAY_NAME=blaxel-main

# --- Laptop ----------------------------------------------------------------
# Local port the OpenShell CLI connects to; `os-tunnel dial` forwards it to
# the gateway in the control sandbox.
LOCAL_PORT=17690
# The OpenShell main CLI (fetched by `make fetch`) and an isolated config dir,
# so another OpenShell install on this machine is left untouched.
# OS_BIN=bin/main/openshell
# OS_CONFIG_HOME=$HOME/.openshell-blaxel/cli-config
